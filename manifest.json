{
  "manifest_version": 3,
  "name": "Story Studio Audio Generator",
  "version": "0.7.34",
  "description": "Generate organized narration audio from Story Studio KH scripts through compatible web sessions.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://fish.audio/*",
    "https://elevenlabs.io/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Story Studio Audio Generator (click to open side panel)",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png",
      "48": "src/icons/icon48.png",
      "128": "src/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://fish.audio/*"
      ],
      "js": [
        "src/content/bridge-main.js",
        "src/content/fish-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fish.audio/*"
      ],
      "js": [
        "src/content/bridge-isolated.js",
        "src/content/fish.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://elevenlabs.io/*"
      ],
      "js": [
        "src/content/bridge-main.js",
        "src/content/eleven-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://elevenlabs.io/*"
      ],
      "js": [
        "src/content/bridge-isolated.js",
        "src/content/eleven.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "key": ""
}
